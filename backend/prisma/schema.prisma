// Mirrors supabase/migrations (the SQL migrations are the source of truth).
// After a schema change update this schema to match the SQL migrations, then run `npx prisma generate`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  product_manager
  sales_manager
  support_agent

  @@map("user_role")
}

enum WarrantyStatus {
  active
  expired
  not_applicable

  @@map("warranty_status")
}

enum OrderStatus {
  processing
  in_transit
  delivered
  cancelled

  @@map("order_status")
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded

  @@map("payment_status")
}

enum ReviewStatus {
  not_applicable
  pending
  approved
  rejected

  @@map("review_status")
}

enum ReturnStatus {
  requested
  received
  approved
  rejected
  refunded

  @@map("return_status")
}

enum ConversationStatus {
  waiting
  active
  resolved
  closed

  @@map("conversation_status")
}

model Profile {
  id             String   @id @db.Uuid
  email          String   @unique
  fullName       String   @map("full_name")
  taxIdEncrypted String?  @map("tax_id_encrypted")
  homeAddress    String?  @map("home_address")
  role           UserRole @default(customer)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  addresses             Address[]
  createdDiscounts      Discount[]            @relation("DiscountCreator")
  cart                  Cart?
  wishlistItems         WishlistItem[]
  orders                Order[]
  invoices              Invoice[]
  deliveries            Delivery[]
  reviews               Review[]              @relation("ReviewAuthor")
  moderatedReviews      Review[]              @relation("ReviewModerator")
  returnRequests        ReturnRequest[]       @relation("ReturnRequester")
  resolvedReturns       ReturnRequest[]       @relation("ReturnResolver")
  approvedRefunds       Refund[]              @relation("RefundApprover")
  notifications         Notification[]
  customerConversations SupportConversation[] @relation("ConversationCustomer")
  assignedConversations SupportConversation[] @relation("ConversationAgent")
  supportMessages       SupportMessage[]      @relation("MessageSender")

  @@map("profiles")
}

model Address {
  id            BigInt   @id @default(autoincrement())
  userId        String   @map("user_id") @db.Uuid
  label         String?
  recipientName String   @map("recipient_name")
  streetAddress String   @map("street_address")
  city          String
  postalCode    String?  @map("postal_code")
  country       String   @default("Turkey")
  phone         String?
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "addresses_user_id_idx")
  @@map("addresses")
}

model Category {
  id           BigInt   @id @default(autoincrement())
  name         String   @unique
  slug         String   @unique
  description  String?
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
}

model Product {
  id             BigInt         @id @default(autoincrement())
  sku            String         @unique
  name           String
  model          String
  serialNumber   String         @unique @map("serial_number")
  description    String
  categoryId     BigInt         @map("category_id")
  stockQuantity  Int            @default(0) @map("stock_quantity")
  price          Decimal        @db.Decimal(12, 2)
  discountRate   Decimal        @default(0) @map("discount_rate") @db.Decimal(5, 2)
  cost           Decimal?       @db.Decimal(12, 2)
  warrantyStatus WarrantyStatus @default(active) @map("warranty_status")
  warrantyTerm   String         @default("24 months") @map("warranty_term")
  distributor    String
  imageUrl       String?        @map("image_url")
  popularity     Int            @default(0)
  averageRating  Decimal        @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount    Int            @default(0) @map("review_count")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants         ProductVariant[]
  productDiscounts ProductDiscount[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  deliveries       Delivery[]
  reviews          Review[]
  returnItems      ReturnItem[]
  notifications    Notification[]

  @@index([categoryId], map: "products_category_id_idx")
  @@index([isActive, popularity(sort: Desc)], map: "products_active_popularity_idx")
  @@map("products")
}

model ProductVariant {
  id            BigInt   @id @default(autoincrement())
  productId     BigInt   @map("product_id")
  sku           String   @unique
  size          String?
  color         String?
  stockQuantity Int      @default(0) @map("stock_quantity")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color], map: "product_variants_unique_attrs")
  @@index([productId], map: "product_variants_product_id_idx")
  @@map("product_variants")
}

model Discount {
  id           BigInt    @id @default(autoincrement())
  name         String?
  discountRate Decimal   @map("discount_rate") @db.Decimal(5, 2)
  startsAt     DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime? @map("ends_at") @db.Timestamptz(6)
  isActive     Boolean   @default(true) @map("is_active")
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  creator          Profile?          @relation("DiscountCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  productDiscounts ProductDiscount[]

  @@index([createdBy], map: "discounts_created_by_idx")
  @@map("discounts")
}

model ProductDiscount {
  id         BigInt   @id @default(autoincrement())
  discountId BigInt   @map("discount_id")
  productId  BigInt   @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([discountId, productId], map: "product_discounts_unique_pair")
  @@index([discountId], map: "product_discounts_discount_id_idx")
  @@index([productId], map: "product_discounts_product_id_idx")
  @@map("product_discounts")
}

model Cart {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @unique @map("user_id") @db.Uuid
  guestToken String?  @unique @map("guest_token")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user  Profile?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        BigInt   @id @default(autoincrement())
  cartId    BigInt   @map("cart_id")
  productId BigInt   @map("product_id")
  variantId BigInt?  @map("variant_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId], map: "cart_items_unique_line")
  @@index([cartId], map: "cart_items_cart_id_idx")
  @@index([productId], map: "cart_items_product_id_idx")
  @@index([variantId], map: "cart_items_variant_id_idx")
  @@map("cart_items")
}

model WishlistItem {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  productId BigInt   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId], map: "wishlist_items_unique_pair")
  @@index([productId], map: "wishlist_items_product_id_idx")
  @@map("wishlist_items")
}

model Order {
  id                 BigInt      @id @default(autoincrement())
  orderNumber        String      @unique @map("order_number")
  userId             String      @map("user_id") @db.Uuid
  status             OrderStatus @default(processing)
  subtotal           Decimal     @db.Decimal(12, 2)
  discountTotal      Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  deliveryFee        Decimal?    @map("delivery_fee") @db.Decimal(12, 2)
  taxAmount          Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount        Decimal     @map("total_amount") @db.Decimal(12, 2)
  deliveryRecipient  String      @map("delivery_recipient")
  deliveryAddress    String      @map("delivery_address")
  deliveryCity       String?     @map("delivery_city")
  deliveryPostalCode String?     @map("delivery_postal_code")
  deliveredAt        DateTime?   @map("delivered_at") @db.Timestamptz(6)
  cancelledAt        DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  user           Profile         @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  payments       Payment[]
  invoice        Invoice?
  deliveries     Delivery[]
  reviews        Review[]
  returnRequests ReturnRequest[]
  refunds        Refund[]
  notifications  Notification[]

  @@index([userId], map: "orders_user_id_idx")
  @@index([status, createdAt(sort: Desc)], map: "orders_status_created_at_idx")
  @@map("orders")
}

model OrderItem {
  id            BigInt   @id @default(autoincrement())
  orderId       BigInt   @map("order_id")
  productId     BigInt   @map("product_id")
  variantId     BigInt?  @map("variant_id")
  productName   String   @map("product_name")
  productModel  String?  @map("product_model")
  quantity      Int
  unitListPrice Decimal  @map("unit_list_price") @db.Decimal(12, 2)
  discountRate  Decimal  @default(0) @map("discount_rate") @db.Decimal(5, 2)
  unitPricePaid Decimal  @map("unit_price_paid") @db.Decimal(12, 2)
  unitCost      Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 2)
  lineTotal     Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  deliveries  Delivery[]
  review      Review?
  returnItems ReturnItem[]

  @@index([orderId], map: "order_items_order_id_idx")
  @@index([productId], map: "order_items_product_id_idx")
  @@index([variantId], map: "order_items_variant_id_idx")
  @@map("order_items")
}

model Payment {
  id             BigInt        @id @default(autoincrement())
  orderId        BigInt        @map("order_id")
  status         PaymentStatus @default(pending)
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  cardBrand      String?       @map("card_brand")
  cardLast4      String?       @map("card_last4")
  transactionRef String?       @unique @map("transaction_ref")
  processedAt    DateTime?     @map("processed_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId], map: "payments_order_id_idx")
  @@map("payments")
}

model Invoice {
  id              BigInt    @id @default(autoincrement())
  invoiceNumber   String    @unique @map("invoice_number")
  orderId         BigInt    @unique @map("order_id")
  userId          String    @map("user_id") @db.Uuid
  billedToName    String    @map("billed_to_name")
  billedToAddress String    @map("billed_to_address")
  subtotal        Decimal   @db.Decimal(12, 2)
  deliveryFee     Decimal?  @map("delivery_fee") @db.Decimal(12, 2)
  taxAmount       Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal   @map("total_amount") @db.Decimal(12, 2)
  pdfStoragePath  String?   @map("pdf_storage_path")
  emailStatus     String    @default("pending") @map("email_status")
  emailError      String?   @map("email_error")
  emailedAt       DateTime? @map("emailed_at") @db.Timestamptz(6)
  issuedAt        DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  Profile @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId], map: "invoices_user_id_idx")
  @@index([issuedAt(sort: Desc)], map: "invoices_issued_at_idx")
  @@map("invoices")
}

model Delivery {
  id              BigInt      @id @default(autoincrement())
  deliveryNumber  String      @unique @map("delivery_number")
  orderId         BigInt      @map("order_id")
  orderItemId     BigInt?     @map("order_item_id")
  customerId      String      @map("customer_id") @db.Uuid
  productId       BigInt      @map("product_id")
  quantity        Int
  totalPrice      Decimal     @map("total_price") @db.Decimal(12, 2)
  deliveryAddress String      @map("delivery_address")
  status          OrderStatus @default(processing)
  isCompleted     Boolean     @default(false) @map("is_completed")
  deliveredAt     DateTime?   @map("delivered_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customer  Profile    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "deliveries_order_id_idx")
  @@index([orderItemId], map: "deliveries_order_item_id_idx")
  @@index([customerId], map: "deliveries_customer_id_idx")
  @@index([productId], map: "deliveries_product_id_idx")
  @@map("deliveries")
}

model Review {
  id            BigInt       @id @default(autoincrement())
  productId     BigInt       @map("product_id")
  userId        String       @map("user_id") @db.Uuid
  orderId       BigInt?      @map("order_id")
  orderItemId   BigInt?      @unique(map: "reviews_unique_order_item") @map("order_item_id")
  rating        Int          @db.SmallInt
  comment       String?
  commentStatus ReviewStatus @default(pending) @map("comment_status")
  moderatedBy   String?      @map("moderated_by") @db.Uuid
  moderatedAt   DateTime?    @map("moderated_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      Profile    @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  moderator Profile?   @relation("ReviewModerator", fields: [moderatedBy], references: [id], onDelete: SetNull)

  @@index([productId], map: "reviews_product_id_idx")
  @@index([userId], map: "reviews_user_id_idx")
  @@index([orderId], map: "reviews_order_id_idx")
  @@index([moderatedBy], map: "reviews_moderated_by_idx")
  @@index([commentStatus], map: "reviews_comment_status_idx")
  @@map("reviews")
}

model ReturnRequest {
  id           BigInt       @id @default(autoincrement())
  returnNumber String       @unique @map("return_number")
  orderId      BigInt       @map("order_id")
  userId       String       @map("user_id") @db.Uuid
  status       ReturnStatus @default(requested)
  reason       String
  requestedAt  DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  resolvedBy   String?      @map("resolved_by") @db.Uuid
  resolvedAt   DateTime?    @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  order    Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user     Profile      @relation("ReturnRequester", fields: [userId], references: [id], onDelete: Restrict)
  resolver Profile?     @relation("ReturnResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  items    ReturnItem[]
  refund   Refund?

  @@index([orderId], map: "return_requests_order_id_idx")
  @@index([userId], map: "return_requests_user_id_idx")
  @@index([resolvedBy], map: "return_requests_resolved_by_idx")
  @@map("return_requests")
}

model ReturnItem {
  id              BigInt    @id @default(autoincrement())
  returnRequestId BigInt    @map("return_request_id")
  orderItemId     BigInt    @map("order_item_id")
  productId       BigInt    @map("product_id")
  quantity        Int
  unitPricePaid   Decimal   @map("unit_price_paid") @db.Decimal(12, 2)
  refundAmount    Decimal   @map("refund_amount") @db.Decimal(12, 2)
  stockRestored   Boolean   @default(false) @map("stock_restored")
  stockRestoredAt DateTime? @map("stock_restored_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId], map: "return_items_unique_item")
  @@index([returnRequestId], map: "return_items_return_request_id_idx")
  @@index([orderItemId], map: "return_items_order_item_id_idx")
  @@index([productId], map: "return_items_product_id_idx")
  @@map("return_items")
}

model Refund {
  id              BigInt        @id @default(autoincrement())
  returnRequestId BigInt        @unique @map("return_request_id")
  orderId         BigInt        @map("order_id")
  paymentId       BigInt?       @map("payment_id")
  approvedBy      String        @map("approved_by") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(succeeded)
  notifiedAt      DateTime?     @map("notified_at") @db.Timestamptz(6)
  refundedAt      DateTime      @default(now()) @map("refunded_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  approver      Profile       @relation("RefundApprover", fields: [approvedBy], references: [id], onDelete: Restrict)

  @@index([orderId], map: "refunds_order_id_idx")
  @@index([paymentId], map: "refunds_payment_id_idx")
  @@index([approvedBy], map: "refunds_approved_by_idx")
  @@map("refunds")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  productId BigInt?   @map("product_id")
  orderId   BigInt?   @map("order_id")
  isRead    Boolean   @default(false) @map("is_read")
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt(sort: Desc)], map: "notifications_user_id_idx")
  @@index([productId], map: "notifications_product_id_idx")
  @@index([orderId], map: "notifications_order_id_idx")
  @@map("notifications")
}

model SupportConversation {
  id              BigInt             @id @default(autoincrement())
  customerId      String?            @map("customer_id") @db.Uuid
  guestToken      String?            @map("guest_token")
  guestName       String?            @map("guest_name")
  guestEmail      String?            @map("guest_email")
  assignedAgentId String?            @map("assigned_agent_id") @db.Uuid
  subject         String?
  status          ConversationStatus @default(waiting)
  claimedAt       DateTime?          @map("claimed_at") @db.Timestamptz(6)
  closedAt        DateTime?          @map("closed_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)

  customer      Profile?         @relation("ConversationCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  assignedAgent Profile?         @relation("ConversationAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]

  @@index([customerId], map: "support_conversations_customer_id_idx")
  @@index([assignedAgentId], map: "support_conversations_assigned_agent_id_idx")
  @@index([status, createdAt], map: "support_conversations_status_idx")
  @@index([guestToken], map: "support_conversations_guest_token_idx")
  @@map("support_conversations")
}

model SupportMessage {
  id             BigInt   @id @default(autoincrement())
  conversationId BigInt   @map("conversation_id")
  senderId       String?  @map("sender_id") @db.Uuid
  senderType     String   @map("sender_type")
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile?            @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  attachments  SupportAttachment[]

  @@index([conversationId, createdAt], map: "support_messages_conversation_id_idx")
  @@index([senderId], map: "support_messages_sender_id_idx")
  @@map("support_messages")
}

model SupportAttachment {
  id            BigInt   @id @default(autoincrement())
  messageId     BigInt   @map("message_id")
  fileName      String   @map("file_name")
  mimeType      String   @map("mime_type")
  mediaCategory String   @map("media_category")
  sizeBytes     BigInt   @map("size_bytes")
  storagePath   String   @map("storage_path")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "support_attachments_message_id_idx")
  @@map("support_attachments")
}
