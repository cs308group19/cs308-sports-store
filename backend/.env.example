# Copy to .env and fill in the values. Never commit .env.

PORT=3000
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Supabase dashboard > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...). Backend only, it can create and delete users. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Supabase dashboard > Connect > "Session pooler" connection string (works over IPv4).
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 32 random bytes, base64 encoded: openssl rand -base64 32
# Encrypts customer tax IDs. If it is lost, stored tax IDs can no longer be read.
FIELD_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32

# Optional. Leave empty locally. Behind a reverse proxy / load balancer, set the number of
# proxy hops (usually 1) so rate limits see each client's IP instead of the proxy's.
TRUST_PROXY=

# Optional, legacy only. Leave empty if the project uses JWT signing keys (the default for new
# projects). Only for a project still on the legacy JWT secret: Project Settings > JWT Keys.
SUPABASE_JWT_SECRET=

# Invoice email (SCRUM-26). All optional: with nothing set, mail goes to a local Mailpit.
# Local testing, option 1 - Mailpit (https://mailpit.axllent.org): run `mailpit`, keep these
# defaults, and read the emails at http://localhost:8025.
# Local testing, option 2 - Ethereal (https://ethereal.email): create a free test account and put
# its host, port, user and password below. Emails are never delivered, only shown on the site.
# Never commit a real SMTP password. Set SMTP_USER and SMTP_PASS together, or leave both empty.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Shown as the sender of every email.
MAIL_FROM=RALLY Sports <no-reply@rally.store>

# Rally, the shopping assistant (SCRUM-113). Without GEMINI_API_KEY and GEMINI_MODEL the chat
# answers 503 and the widget shows "Rally is offline right now" with the contact details below.
# Create a key at https://aistudio.google.com/apikey. Backend only: never put it in the frontend
# and never commit a real one.
GEMINI_API_KEY=
# A cheap "flash" model that supports function calling, for example gemini-3.5-flash-lite.
# Model names change often: check Google's current list first,
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
# How a customer reaches a person ("Talk to a person" in the chat). Placeholders: use your own.
SUPPORT_PHONE=+90 000 000 00 00
SUPPORT_EMAIL=support@rally.store
SUPPORT_HOURS=weekdays 09:00–18:00
