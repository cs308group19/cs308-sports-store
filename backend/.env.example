# Copy to .env and fill in the values. Never commit .env.

PORT=3000
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Supabase dashboard > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...). Backend only, it can create and delete users. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Supabase dashboard > Connect > "Session pooler" connection string (works over IPv4).
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 32 random bytes, base64 encoded: openssl rand -base64 32
# Encrypts customer tax IDs. If it is lost, stored tax IDs can no longer be read.
FIELD_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32

# Optional. Leave empty locally. Behind a reverse proxy / load balancer, set the number of
# proxy hops (usually 1) so rate limits see each client's IP instead of the proxy's.
TRUST_PROXY=

# Optional, legacy only. Leave empty if the project uses JWT signing keys (the default for new
# projects). Only for a project still on the legacy JWT secret: Project Settings > JWT Keys.
SUPABASE_JWT_SECRET=
