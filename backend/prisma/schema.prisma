// Mirrors supabase/migrations (the SQL migrations are the source of truth).
// Auth's cross-schema FK is managed by SQL; never use db push/migrate on this mirror.
// Validate/generate after editing; see ../../supabase/README.md for the integration test.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  product_manager
  sales_manager
  support_agent

  @@map("user_role")
}

model Profile {
  id             String   @id @db.Uuid
  email          String   @unique
  fullName       String   @map("full_name")
  taxIdEncrypted String?  @map("tax_id_encrypted")
  homeAddress    String?  @map("home_address")
  role           UserRole @default(customer)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  cart           Cart?
  orders         Order[]

  @@map("profiles")
}

model Category {
  id         BigInt    @id @default(autoincrement())
  name       String
  slug       String    @unique
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  products   Product[]

  @@map("categories")
}

model Product {
  id              BigInt      @id @default(autoincrement())
  categoryId      BigInt      @map("category_id")
  name            String
  model           String
  serialNumber    String      @unique @map("serial_number")
  description     String
  stockQuantity   Int         @default(0) @map("stock_quantity")
  price           Decimal     @db.Decimal(12, 2)
  cost            Decimal?    @db.Decimal(12, 2)
  imageUrl        String?     @map("image_url")
  warrantyStatus  String      @map("warranty_status")
  distributorInfo String      @map("distributor_info")
  archivedAt      DateTime?   @map("archived_at") @db.Timestamptz(6)
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([categoryId], map: "products_category_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_description_trgm_idx")
  @@map("products")
}

model Cart {
  id             BigInt     @id @default(autoincrement())
  userId         String?    @unique @map("user_id") @db.Uuid
  guestTokenHash Bytes?     @unique @map("guest_token_hash")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user           Profile?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items          CartItem[]

  @@map("carts")
}

model CartItem {
  cartId    BigInt  @map("cart_id")
  productId BigInt  @map("product_id")
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([cartId, productId])
  @@index([productId], map: "cart_items_product_idx")
  @@map("cart_items")
}

model Order {
  id              BigInt      @id @default(autoincrement())
  customerId      String      @map("customer_id") @db.Uuid
  checkoutKey     String      @map("checkout_key") @db.Uuid
  customerName    String      @map("customer_name")
  customerEmail   String      @map("customer_email")
  shippingAddress String      @map("shipping_address")
  currency        String
  status          String      @default("processing")
  placedAt        DateTime    @default(now()) @map("placed_at") @db.Timestamptz(6)
  deliveredAt     DateTime?   @map("delivered_at") @db.Timestamptz(6)
  customer        Profile     @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items           OrderItem[]
  payment         Payment?

  @@unique([customerId, checkoutKey])
  @@index([customerId, placedAt(sort: Desc)], map: "orders_customer_history_idx")
  @@map("orders")
}

model OrderItem {
  id            BigInt  @id @default(autoincrement())
  orderId       BigInt  @map("order_id")
  productId     BigInt  @map("product_id")
  productName   String  @map("product_name")
  quantity      Int
  unitPricePaid Decimal @map("unit_price_paid") @db.Decimal(12, 2)
  // Generated by PostgreSQL. Omit this field on create/update.
  lineTotal     Decimal @default(dbgenerated("((quantity)::numeric * unit_price_paid)")) @map("line_total") @db.Decimal(24, 2)
  order         Order   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product       Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  review        Review?

  @@unique([orderId, productId])
  @@index([productId], map: "order_items_product_idx")
  @@map("order_items")
}

model Payment {
  orderId       BigInt   @id @map("order_id")
  mockReference String   @unique @map("mock_reference")
  amount        Decimal  @db.Decimal(24, 2)
  confirmedAt   DateTime @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice       Invoice?

  @@map("payments")
}

model Invoice {
  orderId       BigInt    @id @map("order_id")
  invoiceNumber String    @unique @map("invoice_number")
  issuedAt      DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  pdfObjectKey  String?   @map("pdf_object_key")
  emailedAt     DateTime? @map("emailed_at") @db.Timestamptz(6)
  payment       Payment   @relation(fields: [orderId], references: [orderId], onDelete: NoAction, onUpdate: NoAction)

  @@map("invoices")
}

model Review {
  orderItemId   BigInt    @id @map("order_item_id")
  rating        Int       @db.SmallInt
  comment       String?
  commentStatus String?   @map("comment_status")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("reviews")
}
